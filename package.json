{
  "name": "movena",
  "private": true,
  "version": "0.1.13",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "vite-dev": "vite",
    "dev": "npm run setup:mpv && npm run setup:twitch && tauri dev",
    "setup:mpv": "node scripts/ensure-windows-mpv.mjs",
    "setup:twitch": "node scripts/build-twitch-resolver.mjs",
    "prebuild": "node scripts/build-output.mjs clean",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/build-output.mjs check",
    "build:msix": "powershell -ExecutionPolicy Bypass -File scripts/make-msix.ps1",
    "build:msix:local": "powershell -ExecutionPolicy Bypass -File scripts/sign-local-msix.ps1",
    "check:types": "tsc -b",
    "check:types:frontend": "tsc -p config/tsconfig.frontend-tests.json",
    "check:types:desktop": "tsc -p config/tsconfig.desktop-tests.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test --config config/playwright.ui.config.ts",
    "test:ui:visual": "cross-env UI_QA_VISUAL=1 playwright test --config config/playwright.ui.config.ts",
    "test:ui:update": "cross-env UI_QA_VISUAL=1 playwright test --config config/playwright.ui.config.ts --update-snapshots",
    "build:desktop-e2e": "tsc -b && vite build --mode desktop-e2e",
    "test:desktop:build": "tauri build --debug --no-bundle --features desktop-e2e --config src-tauri/tauri.e2e.conf.json",
    "test:desktop": "wdio run config/wdio.desktop.conf.ts",
    "test:desktop:all": "npm run test:desktop:build && npm run test:desktop",
    "readme:screenshots": "node scripts/generate-readme-screenshots.mjs && npm run readme:social-preview",
    "readme:social-preview": "node scripts/generate-social-preview.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "store:screenshots": "node scripts/generate-store-screenshots.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test:coverage && npm run test:rust",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design": "node scripts/check-design-system.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dead-code": "knip",
    "check:twitch": "node scripts/check-twitch-packaging.mjs",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "clean:rust": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "check": "npm run format:check && npm run check:architecture && npm run check:design && npm run check:dead-code && npm run check:twitch && npm run format:rust:check && npm run lint && npm run check:types && npm run check:types:frontend && npm run check:types:desktop && npm run test:all && npm run check:clippy",
    "tauri": "tauri",
    "preview": "vite preview",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "check:licenses": "node scripts/generate-third-party-licenses.mjs --check",
    "check:public-tree": "node scripts/check-public-tree.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "country-flag-icons": "^1.6.20",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.5",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.11.6",
    "knip": "^6.34.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
